      "B": 150,
      "C": 24,
      "D:N": 110,
      "O": 24,
      "P:S": 110,
      "T": 24,
      "U:Z": 110,
      "AA": 24,
      "AB": 220,
      "AC": 260,
      "AD:AI": 90,
      "AJ:IA": 110
    },
