{
  "tab": "Concentration.Exposure",
  "note": "The answer of the concentration route. B3 holds the layout version. The script writes B1, B2, B5:B13, B27:B31, D5:N, P5:S, the mix block U5:Z, the rows of the lines from AB5, and one source column for each position from column AJ, with the position id in row 4. A line gives one row for its stock part, one row for its other part, or both, and column AI names the part. The mix block holds one row for each fund of each mix that the request sent. A good refresh also writes its start time and its seconds into A15:B24, newest first, 10 rows at most. This file writes the layout version, the labels, and the format alone. The tab holds no formula and no dollar value.",
  "cells": [
    {
      "range": "A1:A2",
      "values": [["Status"], ["Last run"]]
    },
    {
      "range": "A3:B3",
      "values": [["layoutVersion", 2]]
    },
    {
      "range": "A4:A13",
      "values": [
        ["measure"],
        ["lineCount"],
        ["top10Weight"],
        ["hhi"],
        ["effectiveCount"],
        ["lookedThroughWeight"],
        ["notLookedThroughWeight"],
        ["weightSum"],
        ["weightDifference"],
        ["unknownWeight"]
      ]
    },
    {
      "range": "B4",
      "values": [["value"]]
    },
    {
      "range": "D4:N4",
      "values": [
        [
          "id",
          "ticker",
          "reportDate",
          "accessionNumber",
          "holdingCount",
          "weight",
          "coveredWeight",
          "mergedByTicker",
          "mergedByLei",
          "mergedByName",
          "partWeight"
        ]
      ]
    },
    {
      "range": "P4:S4",
      "values": [["firstId", "secondId", "overlap", "sharedLineCount"]]
    },
    {
      "range": "U4:Z4",
      "values": [["mixId", "mixWeight", "entered", "partTicker", "partWeight", "substitute"]]
    },
    {
      "range": "AB4:AI4",
      "values": [["key", "name", "ticker", "lei", "class", "weight", "stockWeight", "part"]]
    },
    {
      "range": "A14:B14",
      "values": [["runStart", "seconds"]]
    },
    {
      "range": "A26:B26",
      "values": [["equity", "value"]]
    },
    {
      "range": "A27:A31",
      "values": [["weight"], ["lineCount"], ["top10Weight"], ["hhi"], ["effectiveCount"]]
    }
  ],
  "format": {
    "hidden": true,
    "columns": 235,
    "frozenRows": 4,
