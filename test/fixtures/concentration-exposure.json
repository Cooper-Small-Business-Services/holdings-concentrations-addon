{
  "tab": "Concentration.Exposure",
  "note": "The answer of the concentration route and the values that the script computes from it. B3 holds the layout version. The script writes B1, B2, B5:B13, B27:B31, D5:N, P5:S, and the mix block U5:Z. It writes the unseen block AB5:AC, one row for each position with the weight of the lines of the class unknown that came through it. It writes the stock fund block AE5:AE, the own block AG5:AK of the rows that the report shows on a row of their own, and the group block AM5:AP of the other rows of the other part, one row for each class. It writes the rows of the lines from AR5, the direct weight of each row in column AZ, and one source column for each position from column BA, with the position id in row 4. A line gives one row for its stock part, one row for its other part, or both, and column AY names the part. The mix block holds one row for each fund of each mix that the request sent. A good refresh also writes its start time and its seconds into A15:B24, newest first, 10 rows at most. This file writes the layout version, the labels, and the format alone. The tab holds no formula and no dollar value.",
  "cells": [
    {
      "range": "A1:A2",
      "values": [["Status"], ["Last run"]]
    },
    {
      "range": "A3:B3",
      "values": [["layoutVersion", 5]]
    },
    {
      "range": "A4:A13",
      "values": [
        ["measure"],
        ["lineCount"],
        ["top10Weight"],
        ["hhi"],
        ["effectiveCount"],
        ["lookedThroughWeight"],
        ["notLookedThroughWeight"],
        ["weightSum"],
        ["weightDifference"],
        ["unknownWeight"]
      ]
    },
    {
      "range": "B4",
      "values": [["value"]]
    },
    {
      "range": "D4:N4",
      "values": [
        [
          "id",
          "ticker",
          "reportDate",
          "accessionNumber",
          "holdingCount",
          "weight",
          "coveredWeight",
          "mergedByTicker",
          "mergedByLei",
          "mergedByName",
          "partWeight"
        ]
      ]
    },
    {
      "range": "P4:S4",
      "values": [["firstId", "secondId", "overlap", "sharedLineCount"]]
    },
    {
      "range": "U4:Z4",
      "values": [["mixId", "mixWeight", "entered", "partTicker", "partWeight", "substitute"]]
    },
    {
      "range": "AB4:AC4",
      "values": [["unseenId", "unseenWeight"]]
    },
    {
      "range": "AE4:AE4",
      "values": [["stockFundId"]]
    },
    {
      "range": "AG4:AK4",
